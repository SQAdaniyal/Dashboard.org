{
  "version": 2,
  "builds": [
    { "src": "public/**/*", "use": "@vercel/static" },
    { "src": "api/kpis.mjs", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/kpis", "dest": "/api/kpis.mjs" },
    { "src": "/$", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
